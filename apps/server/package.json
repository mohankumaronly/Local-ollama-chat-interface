{
  "name": "@local-ollama/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "node --env-file=.env ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "node --env-file=.env ../../node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@local-ollama/shared": "^0.0.0",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
