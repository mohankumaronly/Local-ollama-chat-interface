# ==============================================================================
# Docker Compose Environment Configuration (.env)
# All settings are OPTIONAL. The stack boots out-of-the-box without this file.
# ==============================================================================

# PostgreSQL credentials for container database
POSTGRES_USER=ollama
POSTGRES_PASSWORD=ollama_secret
POSTGRES_DB=ollama_chat

# Public browser URL displayed in the server startup banner
# Change this if accessing via Cloudflare Tunnel or custom domain
PUBLIC_URL=http://localhost:8080

# Automatic database migrations on server boot (true | false)
MIGRATIONS_AUTO=true

# API Token (OPTIONAL)
# If omitted or empty, the server auto-generates a secure 256-bit token on first boot
# and persists it in the 'local-ollama-api-token' volume (/app/data/api-token).
# Set this only if you want an explicit static token override.
# API_TOKEN=

# Force printing the full token in the startup banner on every boot (true | false)
# Default is false (only first generation prints full token; subsequent boots print fingerprint)
API_TOKEN_FORCE_DISPLAY=false
